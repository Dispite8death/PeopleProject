[PHP]
engine=On
short_open_tag=Off
expose_php=Off
display_errors=Off
display_startup_errors=Off
log_errors=On
error_reporting=E_ALL
error_log="@LOCAL@/logs/php-error.log"
extension_dir="@PHP@/ext"
extension=pdo_mysql
extension=mbstring
extension=openssl
extension=curl
date.timezone=Asia/Magadan
default_charset=UTF-8
cgi.fix_pathinfo=0
cgi.force_redirect=0
fastcgi.impersonate=0
max_execution_time=30
memory_limit=128M
session.save_path="@LOCAL@/sessions"
allow_url_include=Off
