worker_processes 1;
pid "@LOCAL@/run/nginx.pid";
error_log "@LOCAL@/logs/nginx-error.log";
events { worker_connections 256; }
http {
  include "@NGINX@/conf/mime.types";
  default_type application/octet-stream;
  access_log "@LOCAL@/logs/nginx-access.log";
  server_tokens off;
  sendfile on;
  server {
    listen 127.0.0.1:@HTTP@;
    server_name localhost 127.0.0.1;
    root "@ROOT@/public";
    index index.php;
    charset utf-8;
    client_max_body_size 1m;
    location = /index.php {
      include "@NGINX@/conf/fastcgi_params";
      fastcgi_param SCRIPT_FILENAME "@ROOT@/public/index.php";
      fastcgi_param HTTP_PROXY "";
      fastcgi_pass 127.0.0.1:@FCGI@;
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ^~ /api/ { default_type application/json; return 501 '{"error":{"code":"NOT_IMPLEMENTED","message":"Backend is not connected"}}'; }
    location ~ ^/(config|app|scripts|docs|templates|tests|runtime|logs)(/|$) { return 404; }
    location ~ (^|/)\. { return 404; }
    location ~* \.(php|phtml|phar|ini|sql|log|env|json|ps1|bak|conf)$ { return 404; }
  }
}
